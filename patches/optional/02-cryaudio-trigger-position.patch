+//////////////////////////////////////////////////////////////////////////
+// CEVPlayer patch 02-cryaudio-trigger-position: playback position tracking.
+//
+// How the position is measured: the SDL_mixer mixing callback (SDL audio thread) calls the effect registered on a channel
+// with the chunk bytes it mixes into the output for that channel (len, in the device format: Mix_QuerySpec). Counting
+// them gives exactly the number of sample bytes consumed by the mixer, including loops, independent of timers or of the
+// game frame rate. A time stamp taken in the same callback lets a reader interpolate between callbacks (a callback
+// happens every g_bufferSize frames = about 85 ms). The device plays what a callback mixed a little later, so the
+// reported position is "consumed - one buffer + time since the last callback" (an estimate of the audible position, at most
+// two buffers of extrapolation: a paused channel is not mixed, its counter stops and the position freezes).
+//
+// Thread safety: the tracker table is a fixed static array of std::atomic members. Writers: the audio system thread
+// (allocates / initialises a tracker before the channel starts playing) and the SDL threads (effect and done callbacks,
+// both run with the SDL audio device lock held, so they never overlap each other; Mix_HaltChannel also runs the done
+// callback under that lock). The effect callback is the only writer of the counter pair and publishes it with a
+// seqlock. The reader (any thread, the game's main thread in practice) never blocks and never touches an
+// audio thread container: it scans the table, picks the live tracker of the object that was started last and
+// reads the counter pair with the seqlock (retry, give up after a few attempts = "unknown").
+namespace
+{
+constexpr int g_numPositionTrackers = g_numMixChannels; // at most one live tracker per channel
+constexpr int g_positionLeadFrames = 4096;              // = g_bufferSize of Impl.cpp (Mix_OpenAudio): one output buffer
+constexpr double g_maxExtrapolationBuffers = 2.0;
+
+enum : uint32 { TrackerFree = 0, TrackerLive = 1 };
+
+struct SPositionTracker final
+{
+	std::atomic<uint32>      state{ TrackerFree };
+	std::atomic<uint32>      seq{ 0 };               // seqlock of mixedBytes / stampNs, odd = being written
+	std::atomic<void const*> owner{ nullptr };       // the CObject the event instance belongs to
+	std::atomic<uint64>      order{ 0 };             // start order, the highest live one wins a query
+	std::atomic<int64>       mixedBytes{ 0 };
+	std::atomic<int64>       stampNs{ 0 };           // steady clock time of the last effect callback, 0 = none yet
+	std::atomic<uint32>      bytesPerSecond{ 0 };
+	std::atomic<float>       leadSeconds{ 0.0f };    // one output buffer in seconds
+};
+
+SPositionTracker g_positionTrackers[g_numPositionTrackers];
+std::atomic<uint64> g_positionTrackerOrder{ 0 };
+
+int64 PositionNowNs()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// SDL audio thread, once per mixed block of the channel.
+void SDLCALL PositionEffect(int channel, void* pStream, int len, void* pUserData)
+{
+	auto* const pTracker = static_cast<SPositionTracker*>(pUserData);
+
+	if ((pTracker != nullptr) && (len > 0))
+	{
+		int64 const bytes = pTracker->mixedBytes.load(std::memory_order_relaxed) + len;
+		int64 const now = PositionNowNs();
+		uint32 const seq = pTracker->seq.load(std::memory_order_relaxed);
+
+		pTracker->seq.store(seq + 1, std::memory_order_relaxed);
+		std::atomic_thread_fence(std::memory_order_release);
+		pTracker->mixedBytes.store(bytes, std::memory_order_relaxed);
+		pTracker->stampNs.store(now, std::memory_order_relaxed);
+		pTracker->seq.store(seq + 2, std::memory_order_release);
+	}
+}
+
+// Called by SDL_mixer when the effect is removed: the channel finished / was halted, or Mix_UnregisterEffect.
+void SDLCALL PositionEffectDone(int channel, void* pUserData)
+{
+	auto* const pTracker = static_cast<SPositionTracker*>(pUserData);
+
+	if (pTracker != nullptr)
+	{
+		pTracker->owner.store(nullptr, std::memory_order_relaxed);
+		pTracker->state.store(TrackerFree, std::memory_order_release);
+	}
+}
+} // namespace
+
+//////////////////////////////////////////////////////////////////////////
+void BeginPlaybackTracking(int const channel, CObject const* const pObject)
+{
+	if ((channel < 0) || (channel >= g_numMixChannels) || (pObject == nullptr))
+	{
+		return;
+	}
+
+	int frequency = 0;
+	Uint16 format = 0;
+	int numChannels = 0;
+
+	if (Mix_QuerySpec(&frequency, &format, &numChannels) == 0)
+	{
+		return;
+	}
+
+	uint32 const bytesPerSecond = static_cast<uint32>(frequency) * static_cast<uint32>(numChannels) * static_cast<uint32>((format & 0xFF) / 8);
+
+	if (bytesPerSecond == 0)
+	{
+		return;
+	}
+
+	SPositionTracker* pTracker = nullptr;
+
+	for (SPositionTracker& tracker : g_positionTrackers)
+	{
+		uint32 expected = TrackerFree;
+
+		// Only this (audio system) thread allocates; the compare-and-swap just orders us against the free of the SDL threads.
+		if ((tracker.state.load(std::memory_order_acquire) == TrackerFree) && tracker.state.compare_exchange_strong(expected, TrackerLive))
+		{
+			pTracker = &tracker;
+			break;
+		}
+	}
+
+	if (pTracker == nullptr)
+	{
+		return; // no free tracker: this event just has no position
+	}
+
+	// The channel is idle (it comes from the free list), so no SDL thread touches the tracker yet; the tracker only
+	// becomes visible to readers with owner != nullptr and bytes > 0.
+	pTracker->mixedBytes.store(0, std::memory_order_relaxed);
+	pTracker->stampNs.store(0, std::memory_order_relaxed);
+	pTracker->bytesPerSecond.store(bytesPerSecond, std::memory_order_relaxed);
+	pTracker->leadSeconds.store(static_cast<float>(g_positionLeadFrames) / static_cast<float>(frequency), std::memory_order_relaxed);
+	pTracker->order.store(++g_positionTrackerOrder, std::memory_order_relaxed);
+	pTracker->owner.store(pObject, std::memory_order_release);
+
+	// Registered BEFORE the play call: a channel that is not playing is not mixed, so the first mixed block
+	// is already counted. A channel that finished has no effects left (SDL_mixer removes them when it stops).
+	if (Mix_RegisterEffect(channel, &PositionEffect, &PositionEffectDone, pTracker) == 0)
+	{
+		PositionEffectDone(channel, pTracker);
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////
+void EndPlaybackTracking(int const channel)
+{
+	if ((channel >= 0) && (channel < g_numMixChannels))
+	{
+		// Calls PositionEffectDone (frees the tracker) when the effect is registered, does nothing otherwise.
+		Mix_UnregisterEffect(channel, &PositionEffect);
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////
+bool GetObjectPlaybackPosition(CObject const* const pObject, float& outSeconds)
+{
+	if (pObject == nullptr)
+	{
+		return false;
+	}
+
+	SPositionTracker const* pBest = nullptr;
+	uint64 bestOrder = 0;
+
+	for (SPositionTracker const& tracker : g_positionTrackers)
+	{
+		if ((tracker.state.load(std::memory_order_acquire) == TrackerLive) && (tracker.owner.load(std::memory_order_acquire) == pObject))
+		{
+			uint64 const order = tracker.order.load(std::memory_order_relaxed);
+
+			if ((pBest == nullptr) || (order > bestOrder))
+			{
+				pBest = &tracker;
+				bestOrder = order;
+			}
+		}
+	}
+
+	if (pBest == nullptr)
+	{
+		return false;
+	}
+
+	int64 bytes = 0;
+	int64 stamp = 0;
+	bool consistent = false;
+
+	for (int attempt = 0; attempt < 8; ++attempt)
+	{
+		uint32 const seq1 = pBest->seq.load(std::memory_order_acquire);
+
+		if ((seq1 & 1) != 0)
+		{
+			continue;
+		}
+
+		bytes = pBest->mixedBytes.load(std::memory_order_relaxed);
+		stamp = pBest->stampNs.load(std::memory_order_relaxed);
+		std::atomic_thread_fence(std::memory_order_acquire);
+
+		if (pBest->seq.load(std::memory_order_relaxed) == seq1)
+		{
+			consistent = true;
+			break;
+		}
+	}
+
+	uint32 const bytesPerSecond = pBest->bytesPerSecond.load(std::memory_order_relaxed);
+	float const lead = pBest->leadSeconds.load(std::memory_order_relaxed);
+
+	// The tracker may have been freed (and even handed to another event) while it was read: then the answer is "unknown".
+	if (!consistent || (bytes <= 0) || (stamp == 0) || (bytesPerSecond == 0) ||
+	    (pBest->state.load(std::memory_order_acquire) != TrackerLive) ||
+	    (pBest->owner.load(std::memory_order_acquire) != pObject) ||
+	    (pBest->order.load(std::memory_order_relaxed) != bestOrder))
+	{
+		return false;
+	}
+
+	double const mixedSeconds = static_cast<double>(bytes) / static_cast<double>(bytesPerSecond);
+	double const sinceCallback = std::max(0.0, static_cast<double>(PositionNowNs() - stamp) * 1e-9);
+	double const extrapolated = std::min(sinceCallback, g_maxExtrapolationBuffers * static_cast<double>(lead));
+	outSeconds = static_cast<float>(std::max(0.0, mixedSeconds - static_cast<double>(lead) + extrapolated));
+	return true;
+}
