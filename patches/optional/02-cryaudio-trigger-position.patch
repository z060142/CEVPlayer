+//////////////////////////////////////////////////////////////////////////
+namespace
+{
+// CEVPlayer patch 02-cryaudio-trigger-position appended a virtual to Impl::IObject. An implementation module that was not
+// rebuilt with the patch (a stale CryAudioImplSDLMixer.dll, or any other implementation that was built earlier) has a
+// vtable without that slot: calling it would jump into garbage. Only the patched SDL_mixer implementation exports the
+// marker CEVPlayer_AudioImplPositionPatched, and the slot is called only when the loaded SDL_mixer module has it.
+bool ImplHasPlaybackPosition()
+{
+#if CRY_PLATFORM_WINDOWS && !defined(CRY_IS_MONOLITHIC_BUILD)
+	static std::atomic<HMODULE> s_hModule{ nullptr };
+	static std::atomic<bool> s_supported{ false };
+
+	HMODULE const hImpl = ::GetModuleHandleA("CryAudioImplSDLMixer.dll");
+
+	if (hImpl == nullptr)
+	{
+		return false;
+	}
+
+	if (hImpl != s_hModule.load(std::memory_order_acquire))
+	{
+		// First query (or the implementation module was reloaded): look the marker up once per module.
+		bool const supported = ::GetProcAddress(hImpl, "CEVPlayer_AudioImplPositionPatched") != nullptr;
+		s_supported.store(supported, std::memory_order_relaxed);
+		s_hModule.store(hImpl, std::memory_order_release);
+		return supported;
+	}
+
+	return s_supported.load(std::memory_order_relaxed);
+#else
+	return true;
+#endif
+}
+} // namespace
+
+//////////////////////////////////////////////////////////////////////////
+bool CObject::GetTriggerPlaybackPosition(ControlId const triggerId, float& outSeconds) const
+{
+	// Runs on the caller's (main) thread. It does not touch m_triggerInstances or any other container owned by
+	// the audio thread: only the implementation object pointer is read and the implementation answers from its own
+	// thread safe state (see Impl::IObject::GetTriggerPlaybackPosition). The caller must not query an object that
+	// it has already passed to ReleaseObject.
+	Impl::IObject const* const pIObject = m_pIObject;
+	return (pIObject != nullptr) && ImplHasPlaybackPosition() && pIObject->GetTriggerPlaybackPosition(triggerId, outSeconds);
+}
