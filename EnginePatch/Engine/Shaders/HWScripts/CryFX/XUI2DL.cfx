// Portions derived from XTFrame for CRYENGINE (XUI2D), Copyright (c) 2026 XTFrame contributors, MIT license.
// XUI2DL: the minimal 2D stage of CEVPlayer (Code/CryEngine/RenderDll/XUI2DL). Derived from XUI2D.cfx
// of XTFrame for CRYENGINE (CE_XTUI), MIT; see RenderDll/XUI2DL/NOTICE.md. Techniques: XUI2DLSolid,
// XUI2DLTexture (premultiplied texture), XUI2DLTextureStraight (straight texture, premultiplied here).
// Every output is premultiplied; texture row 0 is the top row.

#include "common.cfi"

// Per-pass constants (XUI2DL.cpp SPassConstants), register b0.
cbuffer CBXUI2DL : register(b0)
{
	struct
	{
		float4x4 matViewProj;   // viewport pixels (origin top-left) -> clip space, reverse depth
		float4   params;        // x,y = 1 / viewport size; z,w = target size in pixels
	} cbXUIL;
};

// Vertex: POSITION = (x*w, y*w, w) homogeneous viewport pixels; COLOR premultiplied r,g,b,a.
struct SXUILApp2VS
{
	float3 pos : POSITION;
	float2 tex : TEXCOORD0;
	float4 col : COLOR0;
};

struct SXUILVS2PS
{
	float4 pos : SV_Position;
	float2 tex : TEXCOORD0;
	float4 col : COLOR0;
};

Texture2D    texXUIL0 : register(t0);
SamplerState smpXUIL  : register(s0);

SXUILVS2PS XUI2DLVS(SXUILApp2VS IN)
{
	SXUILVS2PS OUT = (SXUILVS2PS) 0;
	OUT.pos = mul(cbXUIL.matViewProj, float4(IN.pos.xy, 0.0, IN.pos.z));
	OUT.col = IN.col;
	OUT.tex = IN.tex;
	return OUT;
}

float4 XUI2DLSolidPS(SXUILVS2PS IN) : SV_Target0
{
	return IN.col;
}

float4 XUI2DLTexturePS(SXUILVS2PS IN) : SV_Target0
{
	return GetTexture2D(texXUIL0, smpXUIL, IN.tex) * IN.col;
}

float4 XUI2DLTextureStraightPS(SXUILVS2PS IN) : SV_Target0
{
	const float4 s = GetTexture2D(texXUIL0, smpXUIL, IN.tex);
	return float4(s.rgb * s.a, s.a) * IN.col;
}

technique XUI2DLSolid           { pass p0 { VertexShader = XUI2DLVS(); PixelShader = XUI2DLSolidPS(); } }
technique XUI2DLTexture         { pass p0 { VertexShader = XUI2DLVS(); PixelShader = XUI2DLTexturePS(); } }
technique XUI2DLTextureStraight { pass p0 { VertexShader = XUI2DLVS(); PixelShader = XUI2DLTextureStraightPS(); } }
