<?xml version="1.0" encoding="utf-8"?>
<!-- Hand written minimal ACE data for the SDL_mixer implementation (what the Audio Controls Editor would write for a
     start / pause / resume event of one sample). Goes to <game>/audio/sdlmixer/ace/. The WAV is generated by
     tools/make_cue_test_assets.sh into <game>/audio/sdlmixer/assets/ (not versioned).
     Pause / resume are SDL_mixer event ACTIONS (type="pause" / "resume"): they act on the playing instances of the
     same sample on the same audio object. -->
<AudioSystemData name="cev_test" version="2" triggers="3" parameters="0" switches="0" states="0" environments="0" preloads="0" settings="0" files="0">
	<Triggers>
		<Trigger name="cev_test_beep">
			<Event name="cev_test_beep.wav" path="" type="start" volume="0" loop_count="1"/>
		</Trigger>
		<Trigger name="cev_test_beep_pause">
			<Event name="cev_test_beep.wav" path="" type="pause"/>
		</Trigger>
		<Trigger name="cev_test_beep_resume">
			<Event name="cev_test_beep.wav" path="" type="resume"/>
		</Trigger>
	</Triggers>
	<ImplData events="3" parameters="0" parametersadvanced="0" switchstates="0" files="0"/>
</AudioSystemData>
