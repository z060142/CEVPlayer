<?xml version="1.0" encoding="utf-8"?>
<!--
  Build-time compatibility for stock CRYENGINE 5.7.1 on current VS 2022 toolsets, injected with
    MSBuild CRYENGINE_Win64.sln ... -p:ForceImportBeforeCppTargets=<this file>
  so no engine file is edited. Qt 5.12's qlist.h uses stdext::make_checked_array_iterator, which the
  VS 2022 17.8+ STL deprecates (STL4043); under CE's /WX that breaks EditorCommon and every editor
  plugin including EditorXTUI.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
