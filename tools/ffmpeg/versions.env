# Pinned sources of the CEVPlayer minimal FFmpeg build (sourced by build_minimal.sh, read by the workflow).
# Every download is verified against its SHA-256 before it is unpacked; change a version and its hash together.
#
# CEV_BUILD_REV: bump it when only the build recipe changes (same sources). The release version is
#   <FFMPEG_VERSION>-cev<CEV_BUILD_REV>   e.g. 8.0.3-cev1  -> tag ffmpeg-minimal-v8.0.3-cev1
# and is what the plugin pins as kFfmpegMinimalVersion (together with the SHA-256 of the released zip).

CEV_BUILD_REV=1

FFMPEG_VERSION=8.0.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz
FFMPEG_SHA256=6136812ea6d4e68bdba27e33c2a94382711cdf4f8602ffef056ff792bd6f9818

# libvpx (BSD-3-Clause): VP8 / VP9 encoder and decoder. GitHub tag archive.
LIBVPX_VERSION=1.15.0
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.15.0.tar.gz
LIBVPX_SHA256=e935eded7d81631a538bfae703fd1e293aad1c7fd3407ba00440c95105d2011e

# libopus (BSD-3-Clause)
OPUS_VERSION=1.5.2
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1

# libogg (BSD-3-Clause)
LIBOGG_VERSION=1.3.5
LIBOGG_URL=https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.xz
LIBOGG_SHA256=c4d91be36fc8e54deae7575241e03f4211eb102afb3fc0775fbbc1b740016705

# libvorbis (BSD-3-Clause)
LIBVORBIS_VERSION=1.3.7
LIBVORBIS_URL=https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.xz
LIBVORBIS_SHA256=b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b

# dav1d (BSD-2-Clause): AV1 decoder
DAV1D_VERSION=1.5.3
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.3/dav1d-1.5.3.tar.xz
DAV1D_SHA256=732010aa5ef461fa93355ed2c6c5fedb48ddc4b74e697eaabe8907eaeb943011

# zlib (zlib licence): needed by FFmpeg's png decoder (inflate). Official release tarball; the SHA-256 equals the
# one published on zlib.net and the GitHub release asset digest (checked 2026-11-19).
ZLIB_VERSION=1.4
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.xz
ZLIB_SHA256=4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c
