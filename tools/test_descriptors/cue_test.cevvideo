<?xml version="1.0" encoding="UTF-8"?>
<!-- Cue route with a trigger that does not exist in the audio data (Play_Intro_EN): CryAudio reports the failed request,
     one warning, the video plays on the video clock without sound. (cue_beep.cevvideo is the working example.) -->
<CEVVideo version="1" route="cue" video="vp8_vorbis.webm">
  <AudioTracks default="voice">
    <Track name="voice" trigger="Play_Intro_EN"/>
  </AudioTracks>
</CEVVideo>
