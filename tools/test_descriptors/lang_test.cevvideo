<?xml version="1.0" encoding="UTF-8"?>
<!-- M2a test: mixed route, embedded english, external japanese (audio_ja.webm), a missing file (falls back to the
     embedded track), a cue-only language (M3: silent + warning) and two markers. -->
<CEVVideo version="1" route="mixed" video="opus_preskip.webm" avOffsetMs="0">
  <Languages default="english">
    <Language name="english" embedded="1"/>
    <Language name="japanese" file="audio_ja.webm"/>
    <Language name="english2" file="audio_en.webm"/>
    <Language name="french" file="missing_fr.webm"/>
    <Language name="german" trigger="Play_Intro_DE"/>
  </Languages>
  <Markers>
    <Marker name="start_mark" time="1.0"/>
    <Marker name="mid_mark" time="3.0"/>
  </Markers>
</CEVVideo>
